<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_goal_card"
        android:padding="12dp">

        <View
            android:id="@+id/dragHandleGoal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:background="@drawable/bg_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="16sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/goalTitleView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/goalCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_percent_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="0 lượt" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/goalCurrentView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/goalTargetView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|bottom"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ProgressBar
                android:id="@+id/goalProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:progressDrawable="@drawable/progress_gradient"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/goalPercentInBar"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:text="0%" />
        </FrameLayout>

        <TextView
            android:id="@+id/goalSubtitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>

    <View android:id="@+id/resizeGoalTL" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" />
    <View android:id="@+id/resizeGoalTR" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|end" />
    <View android:id="@+id/resizeGoalBL" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="bottom|start" />
    <View android:id="@+id/resizeGoalBR" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="bottom|end" />

</FrameLayout>
