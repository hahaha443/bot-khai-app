<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình server"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://100.x.x.x:8000" />

        <EditText
            android:id="@+id/editApiToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API token"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu cấu hình" />

        <View style="@style/DividerLine" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888"
            android:text="Quyền hiển thị nổi/thông báo tự kiểm tra và tự dẫn tới màn cấp quyền khi mở app, không cần bấm gì." />

        <View style="@style/DividerLine" />

        <CheckBox
            android:id="@+id/checkAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự bật cả 2 menu khi mở app" />

        <CheckBox
            android:id="@+id/checkLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Khoá tương tác 2 menu (chơi game khỏi sợ bấm trúng)" />

        <Button
            android:id="@+id/btnToggleReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bật / tắt menu Báo cáo" />

        <TextView style="@style/SliderLabel" android:text="Kích thước menu Báo cáo (hoặc kéo góc ⤡ trên menu để chỉnh tự do)" />
        <SeekBar
            android:id="@+id/seekReportSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="60" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ NỀN bảng Báo cáo (chữ vẫn rõ)" />
        <SeekBar
            android:id="@+id/seekReportBgOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="0" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ NỘI DUNG bảng Báo cáo (nền vẫn rõ)" />
        <SeekBar
            android:id="@+id/seekReportContentOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="0" />

        <Button
            android:id="@+id/btnToggleQR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bật / tắt menu QR" />

        <TextView style="@style/SliderLabel" android:text="Kích thước menu QR (hoặc kéo góc ⤡ trên menu để chỉnh tự do)" />
        <SeekBar
            android:id="@+id/seekQrSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="60" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ bảng QR" />
        <SeekBar
            android:id="@+id/seekQrOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ popup thông báo giao dịch mới" />
        <SeekBar
            android:id="@+id/seekAlertOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20" />

        <Button
            android:id="@+id/btnDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF9800"
            android:text="🧪 Xem thử (bơm dữ liệu demo để canh chỉnh)" />

        <View style="@style/DividerLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Màu chữ chung (Báo cáo / Ghi chú / Mục tiêu)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7">

            <View android:id="@+id/colorWhite" style="@style/ColorSwatch" android:background="#FFFFFF" />
            <View android:id="@+id/colorYellow" style="@style/ColorSwatch" android:background="#FFEB3B" />
            <View android:id="@+id/colorCyan" style="@style/ColorSwatch" android:background="#00E5FF" />
            <View android:id="@+id/colorGreen" style="@style/ColorSwatch" android:background="#4CAF50" />
            <View android:id="@+id/colorPink" style="@style/ColorSwatch" android:background="#FF4081" />
            <View android:id="@+id/colorOrange" style="@style/ColorSwatch" android:background="#FF9800" />
            <View android:id="@+id/colorRed" style="@style/ColorSwatch" android:background="#F44336" />
        </LinearLayout>

        <View style="@style/DividerLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Ghi chú nổi (menu rời #3 — thêm được nhiều cái)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editNoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nội dung ghi chú mới..."
            android:minLines="2"
            android:gravity="top" />

        <Button
            android:id="@+id/btnAddNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Thêm ghi chú mới" />

        <LinearLayout
            android:id="@+id/noteListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnToggleNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bật / tắt tất cả menu Ghi chú" />

        <TextView style="@style/SliderLabel" android:text="Kích thước mỗi ghi chú (hoặc kéo góc trên menu)" />
        <SeekBar
            android:id="@+id/seekNoteSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="60" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ menu Ghi chú" />
        <SeekBar
            android:id="@+id/seekNoteOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="0" />

        <View style="@style/DividerLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Thanh đo mục tiêu (menu rời #4)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiêu đề (vd: Mục tiêu donate hôm nay)" />

        <EditText
            android:id="@+id/editGoalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số tiền mục tiêu (vd: 5000000)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnSaveGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu mục tiêu" />

        <Button
            android:id="@+id/btnToggleGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bật / tắt menu Thanh đo mục tiêu" />

        <TextView style="@style/SliderLabel" android:text="Kích thước menu Mục tiêu (hoặc kéo góc trên menu)" />
        <SeekBar
            android:id="@+id/seekGoalSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="600"
            android:min="80" />

        <TextView style="@style/SliderLabel" android:text="Độ mờ menu Mục tiêu" />
        <SeekBar
            android:id="@+id/seekGoalOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="0" />

        <View style="@style/DividerLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thống kê"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/textStatToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingBottom="2dp" android:text="Hôm nay: —" />
        <TextView android:id="@+id/textStatYesterday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingBottom="2dp" android:text="Hôm qua: —" />
        <TextView android:id="@+id/textStatBeforeYesterday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingBottom="8dp" android:text="Hôm kia: —" />

        <Button
            android:id="@+id/btnRefreshStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Làm mới thống kê" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📜 Xem lịch sử giao dịch đầy đủ" />

    </LinearLayout>
</ScrollView>
