<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💜 Donate Float"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quản lý các menu nổi hiển thị đè lên mọi ứng dụng"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Ẩn/hiện tạm tất cả -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="🙈  Ẩn nhanh khi share màn hình" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginBottom="8dp"
                    android:text="Ẩn tạm toàn bộ menu nổi (không tắt hẳn, giữ nguyên vị trí/cấu hình) — bật lại chỉ 1 chạm." />
                <Button
                    android:id="@+id/btnHideAllOverlays"
                    style="@style/BtnFlat"
                    android:layout_marginTop="0dp"
                    android:text="🙈  Ẩn tạm tất cả menu" />
            </LinearLayout>

            <!-- Cấu hình server -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="🌐  Cấu hình server" />

                <EditText
                    android:id="@+id/editServerUrl"
                    style="@style/FieldInput"
                    android:hint="http://100.x.x.x:8000"
                    android:layout_marginTop="0dp" />

                <EditText
                    android:id="@+id/editApiToken"
                    style="@style/FieldInput"
                    android:hint="API token"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnSaveConfig"
                    style="@style/BtnPrimary"
                    android:text="Lưu cấu hình" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:text="Quyền hiển thị nổi/thông báo tự kiểm tra và tự dẫn tới màn cấp quyền khi mở app, không cần bấm gì." />
            </LinearLayout>

            <!-- Chung -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="⚙️  Chung" />

                <CheckBox
                    android:id="@+id/checkAutoStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:text="Tự bật cả 2 menu khi mở app" />

                <TextView
                    android:id="@+id/textLockHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- Báo cáo giao dịch -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="📊  Menu Báo cáo giao dịch" />

                <Button
                    android:id="@+id/btnToggleReport"
                    style="@style/BtnFlat"
                    android:layout_marginTop="0dp"
                    android:text="Bật / tắt menu Báo cáo" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ NỀN bảng Báo cáo (chữ vẫn rõ)" />
                <SeekBar
                    android:id="@+id/seekReportBgOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_cyan"
                    android:thumbTint="@color/accent_cyan"
                    android:max="100"
                    android:min="0" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ NỘI DUNG bảng Báo cáo (nền vẫn rõ)" />
                <SeekBar
                    android:id="@+id/seekReportContentOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_cyan"
                    android:thumbTint="@color/accent_cyan"
                    android:max="100"
                    android:min="0" />

                <Button
                    android:id="@+id/btnColorReport"
                    style="@style/BtnFlat"
                    android:text="🎨  Màu chữ Báo cáo" />
            </LinearLayout>

            <!-- QR + alert -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="🔳  Menu QR chuyển khoản" />

                <Button
                    android:id="@+id/btnToggleQR"
                    style="@style/BtnFlat"
                    android:layout_marginTop="0dp"
                    android:text="Bật / tắt menu QR" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ bảng QR" />
                <SeekBar
                    android:id="@+id/seekQrOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_magenta"
                    android:thumbTint="@color/accent_magenta"
                    android:max="100"
                    android:min="20" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ popup thông báo giao dịch mới" />
                <SeekBar
                    android:id="@+id/seekAlertOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_magenta"
                    android:thumbTint="@color/accent_magenta"
                    android:max="100"
                    android:min="20" />

                <Button
                    android:id="@+id/btnDemo"
                    style="@style/BtnWarn"
                    android:text="🧪  Xem thử (bơm dữ liệu demo để canh chỉnh)" />
            </LinearLayout>

            <!-- Ghi chú -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="📝  Menu Ghi chú nổi (nhiều cái cùng lúc)" />

                <EditText
                    android:id="@+id/editNoteText"
                    style="@style/FieldInput"
                    android:hint="Nội dung ghi chú mới..."
                    android:minLines="2"
                    android:gravity="top"
                    android:layout_marginTop="0dp" />

                <Button
                    android:id="@+id/btnAddNote"
                    style="@style/BtnPrimary"
                    android:text="+  Thêm ghi chú mới" />

                <LinearLayout
                    android:id="@+id/noteListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnColorNote"
                    style="@style/BtnFlat"
                    android:text="🎨  Màu chữ Ghi chú" />

                <Button
                    android:id="@+id/btnToggleNote"
                    style="@style/BtnFlat"
                    android:text="Bật / tắt tất cả menu Ghi chú" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ NỀN Ghi chú (chữ vẫn rõ)" />
                <SeekBar
                    android:id="@+id/seekNoteBgOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary"
                    android:max="100"
                    android:min="0" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ NỘI DUNG Ghi chú (nền vẫn rõ)" />
                <SeekBar
                    android:id="@+id/seekNoteContentOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary"
                    android:max="100"
                    android:min="0" />
            </LinearLayout>

            <!-- Thanh đo mục tiêu -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="🎯  Menu Thanh đo mục tiêu" />

                <EditText
                    android:id="@+id/editGoalTitle"
                    style="@style/FieldInput"
                    android:hint="Tiêu đề (vd: Mục tiêu donate hôm nay)"
                    android:layout_marginTop="0dp" />

                <EditText
                    android:id="@+id/editGoalAmount"
                    style="@style/FieldInput"
                    android:hint="Số tiền mục tiêu (vd: 5000000)"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/editGoalNote"
                    style="@style/FieldInput"
                    android:hint="Ghi chú thêm dưới thanh (vd: Cảm ơn mọi người đã ủng hộ!)"
                    android:minLines="2"
                    android:gravity="top" />

                <Button
                    android:id="@+id/btnSaveGoal"
                    style="@style/BtnPrimary"
                    android:text="Lưu mục tiêu" />

                <Button
                    android:id="@+id/btnColorGoal"
                    style="@style/BtnFlat"
                    android:text="🎨  Màu chữ Mục tiêu" />

                <Button
                    android:id="@+id/btnToggleGoal"
                    style="@style/BtnFlat"
                    android:text="Bật / tắt menu Thanh đo mục tiêu" />

                <TextView style="@style/SliderLabel" android:text="Độ mờ menu Mục tiêu" />
                <SeekBar
                    android:id="@+id/seekGoalOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accent_cyan"
                    android:thumbTint="@color/accent_cyan"
                    android:max="100"
                    android:min="0" />
            </LinearLayout>

            <!-- Thống kê -->
            <LinearLayout style="@style/SectionCard">
                <TextView style="@style/SectionTitle" android:text="📈  Thống kê" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_chip"
                    android:padding="12dp">

                    <TextView android:id="@+id/textStatToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_primary" android:paddingBottom="4dp" android:text="Hôm nay: —" />
                    <TextView android:id="@+id/textStatYesterday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" android:paddingBottom="4dp" android:text="Hôm qua: —" />
                    <TextView android:id="@+id/textStatBeforeYesterday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" android:text="Hôm kia: —" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRefreshStats"
                    style="@style/BtnFlat"
                    android:text="🔄  Làm mới thống kê" />

                <Button
                    android:id="@+id/btnHistory"
                    style="@style/BtnFlat"
                    android:text="📜  Xem lịch sử giao dịch đầy đủ" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
