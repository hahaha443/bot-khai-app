<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#38BDF8"
                android:centerColor="#6366F1"
                android:endColor="#818CF8" />
        </shape>
    </item>
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.5dp" />
            <solid android:color="#F2101522" />
        </shape>
    </item>
</layer-list>
