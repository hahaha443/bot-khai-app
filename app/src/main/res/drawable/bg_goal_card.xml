<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#00E5FF"
                android:centerColor="#7C4DFF"
                android:endColor="#D500F9" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#DD141414" />
        </shape>
    </item>
</layer-list>
